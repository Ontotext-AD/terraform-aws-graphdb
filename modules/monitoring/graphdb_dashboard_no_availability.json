{
  "widgets": [
      {
          "height": 6,
          "width": 8,
          "y": 0,
          "x": 16,
          "type": "metric",
          "properties": {
              "metrics": ${open_repositories_metrics},
              "region": "${aws_region}",
              "stacked": false,
              "view": "timeSeries",
              "period": ${dashboard_period},
              "stat": "Maximum",
              "yAxis": {
                  "left": {
                      "min": 0,
                      "label": "Count",
                      "showUnits": false
                  },
                  "right": {
                      "label": "",
                      "showUnits": false
                  }
              },
              "title": "%{ if graphdb_node_count > 1 }GraphDB leader open repositories%{ else }GraphDB open repositories%{ endif }"
          }
      },
      {
          "height": 6,
          "width": 8,
          "y": 0,
          "x": 0,
          "type": "metric",
          "properties": {
              "metrics": [
                  [ { "expression": "SELECT MAX(CPUUtilization) FROM \"AWS/EC2\" WHERE AutoScalingGroupName = '${resource_name_prefix}' GROUP BY AutoScalingGroupName", "label": "Query1", "id": "q1", "region": "${aws_region}" } ]
              ],
              "region": "${aws_region}",
              "stacked": false,
              "view": "timeSeries",
              "period": ${dashboard_period},
              "stat": "Average",
              "yAxis": {
                  "left": {
                      "max": 100,
                      "label": "Percent",
                      "showUnits": false
                  },
                  "right": {
                      "label": "",
                      "showUnits": false
                  }
              },
              "title": "CPU utilization for the Auto Scaling Group"
          }
      },
      {
        "height": 6,
        "width": 8,
        "y": 0,
        "x": 8,
        "type": "metric",
        "properties": {
            "metrics": [
                [ { "expression": "SELECT MAX(mem_used_percent) FROM \"CWAgent\" WHERE AutoScalingGroupName = '${resource_name_prefix}' GROUP BY AutoScalingGroupName", "label": "Query1", "id": "q1", "region": "${aws_region}" } ]
            ],
            "region": "${aws_region}",
            "stacked": false,
            "view": "timeSeries",
            "period": ${dashboard_period},
            "stat": "Average",
            "yAxis": {
                "left": {
                    "max": 100,
                    "label": "Percent",
                    "showUnits": false
                },
                "right": {
                    "label": "",
                    "showUnits": false
                }
            },
            "title": "GraphDB Memory Used % for the Auto Scaling Group"
        }
    },
      {
          "height": 6,
          "width": 6,
          "y": 6,
          "x": 6,
          "type": "metric",
          "properties": {
              "metrics": [
                  [ { "expression": "SELECT AVG(graphdb_data_dir_free) FROM \"${resource_name_prefix}\" GROUP BY host", "label": "Query1", "id": "q1", "region": "${aws_region}" } ]
              ],
              "region": "${aws_region}",
              "stacked": false,
              "view": "timeSeries",
              "period": ${dashboard_period},
              "stat": "Average",
              "yAxis": {
                  "left": {
                      "label": "Gigabytes",
                      "showUnits": false
                  },
                  "right": {
                      "label": "",
                      "showUnits": false
                  }
              },
              "title": "GraphDB Data Dir Free per instance"
          }
      },
      {
          "height": 6,
          "width": 6,
          "y": 6,
          "x": 0,
          "type": "metric",
          "properties": {
              "metrics": [
                  [ { "expression": "SELECT AVG(graphdb_data_dir_used) FROM \"${resource_name_prefix}\" GROUP BY host", "label": "Query1", "id": "q1", "region": "${aws_region}" } ]
              ],
              "region": "${aws_region}",
              "stacked": false,
              "view": "timeSeries",
              "period": ${dashboard_period},
              "stat": "Average",
              "yAxis": {
                  "left": {
                      "label": "Gigabytes",
                      "showUnits": false
                  },
                  "right": {
                      "label": "",
                      "showUnits": false
                  }
              },
              "title": "GraphDB Data Dir Used per instance"
          }
      },
      {
          "height": 6,
          "width": 6,
          "y": 6,
          "x": 12,
          "type": "metric",
          "properties": {
              "metrics": ${active_transactions_metrics},
              "region": "${aws_region}",
              "stacked": false,
              "view": "timeSeries",
              "period": ${dashboard_period},
              "stat": "Maximum",
              "yAxis": {
                  "left": {
                      "min": 0,
                      "label": "Count",
                      "showUnits": false
                  },
                  "right": {
                      "label": "",
                      "showUnits": false
                  }
              },
              "title": "%{ if graphdb_node_count > 1 }GraphDB leader active transactions%{ else }GraphDB active transactions per repository%{ endif }"
          }
      },
      {
          "height": 6,
          "width": 6,
          "y": 6,
          "x": 18,
          "type": "metric",
          "properties": {
              "metrics": ${open_connections_metrics},
              "region": "${aws_region}",
              "stacked": false,
              "view": "timeSeries",
              "period": ${dashboard_period},
              "stat": "Maximum",
              "yAxis": {
                  "left": {
                      "min": 0,
                      "label": "Count",
                      "showUnits": false
                  },
                  "right": {
                      "label": "",
                      "showUnits": false
                  }
              },
              "title": "%{ if graphdb_node_count > 1 }GraphDB leader open connections%{ else }GraphDB open connections per repository%{ endif }"
          }
      }%{ if graphdb_node_count > 1 },
      {
          "height": 6,
          "width": 8,
          "y": 12,
          "x": 0,
          "type": "metric",
          "properties": {
              "metrics": [
                  [ { "expression": "SELECT COUNT(graphdb_failure_recoveries_count) FROM \"${resource_name_prefix}\"", "label": "Query1", "id": "q1", "region": "${aws_region}" } ]
              ],
              "region": "${aws_region}",
              "stacked": false,
              "view": "timeSeries",
              "period": ${dashboard_period},
              "stat": "Average",
              "yAxis": {
                  "left": {
                      "label": "Count",
                      "showUnits": false
                  },
                  "right": {
                      "label": "",
                      "showUnits": false
                  }
              },
              "title": "GraphDB Failure Recoveries"
          }
      },
      {
          "height": 6,
          "width": 8,
          "y": 12,
          "x": 8,
          "type": "metric",
          "properties": {
              "metrics": [
                  [ { "expression": "SELECT MAX(graphdb_nodes_disconnected) FROM \"${resource_name_prefix}\"", "label": "Query1", "id": "q1", "region": "${aws_region}" } ]
              ],
              "region": "${aws_region}",
              "stacked": false,
              "view": "timeSeries",
              "period": ${dashboard_period},
              "stat": "Average",
              "yAxis": {
                  "left": {
                      "label": "Count",
                      "showUnits": false
                  },
                  "right": {
                      "label": "",
                      "showUnits": false
                  }
              },
              "title": "GraphDB nodes disconnected"
          }
      },
      {
        "height": 6,
        "width": 8,
        "y": 12,
        "x": 16,
        "type": "metric",
        "properties": {
            "metrics": [
                [ { "expression": "SELECT MAX(graphdb_nodes_out_of_sync) FROM \"${resource_name_prefix}\"", "label": "Query1", "id": "q1", "region": "${aws_region}" } ]
            ],
            "region": "${aws_region}",
            "stacked": false,
            "view": "timeSeries",
            "period": ${dashboard_period},
            "stat": "Average",
            "yAxis": {
                "left": {
                    "label": "Count",
                    "showUnits": false
                },
                "right": {
                    "label": "",
                    "showUnits": false
                }
            },
            "title": "GraphDB nodes out of sync"
        }
    }%{ endif }
  ]
}
